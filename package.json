{
  "name": "@zakiaziz/fireflies-cli",
  "version": "0.1.0",
  "description": "A complete command line interface for the Fireflies.ai API.",
  "type": "module",
  "bin": {
    "fireflies": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "bun build bin/fireflies.ts --target=node --outfile dist/cli.js",
    "check": "tsc --noEmit",
    "test": "bun run build && bun test --coverage",
    "prepack": "bun run build",
    "dev": "bun --watch bin/fireflies.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "fireflies",
    "cli",
    "meetings",
    "transcription",
    "graphql"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "graphql": "^17.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakiaziz/fireflies-cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
